{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "paths": {
      "@magnitudedev/agent": ["./packages/agent/src"],
      "@magnitudedev/roles": ["./packages/roles/src"],
      "@magnitudedev/roles/constants": ["./packages/roles/src/constants"],
      "@magnitudedev/event-core": ["./packages/event-core/src"],
      "@magnitudedev/effect-query": ["./packages/effect-query/src"],
      "@magnitudedev/effect-query/*": ["./packages/effect-query/src/*"],

      "@magnitudedev/ai": ["./packages/ai/src"],
      "@magnitudedev/providers": ["./packages/providers/src"],

      "@magnitudedev/scratchpad": ["./packages/scratchpad/src"],
      "@magnitudedev/acn-protocol": ["./packages/acn-protocol/src"],
      "@magnitudedev/acn-protocol/*": ["./packages/acn-protocol/src/*"],
      "@magnitudedev/sdk": ["./packages/sdk/src"],
      "@magnitudedev/storage": ["./packages/storage/src"],
      "@magnitudedev/acn": ["./packages/acn/src"],
      "@magnitudedev/version": ["./packages/version/src"],
      "@magnitudedev/utils": ["./packages/utils/src"],
      "@magnitudedev/utils/*": ["./packages/utils/src/*"],
      "@magnitudedev/generate-id": ["./packages/generate-id/src"],
      "@magnitudedev/ripgrep": ["./packages/ripgrep/src"],
      "@magnitudedev/client-common": ["./packages/client-common/src"],
      "@magnitudedev/icn-contracts": ["./packages/icn-contracts/src"],
      "@magnitudedev/icn-contracts/*": ["./packages/icn-contracts/src/*"],
      "@magnitudedev/icn-models": ["./packages/icn-models/src"],
      "@magnitudedev/icn-models/*": ["./packages/icn-models/src/*"],
      "@magnitudedev/icn-native": ["./packages/icn-native/src"],
      "@magnitudedev/icn-engine": ["./packages/icn-engine/src"],
      "@magnitudedev/icn-engine/*": ["./packages/icn-engine/src/*"],
      "@magnitudedev/icn-parity": ["./packages/icn-parity/src"],
      "@magnitudedev/icn-parity/*": ["./packages/icn-parity/src/*"],
      "@magnitudedev/icn-protocol": ["./packages/icn-protocol/src"],
      "@magnitudedev/icn-protocol/*": ["./packages/icn-protocol/src/*"],
      "@magnitudedev/icn-server": ["./packages/icn-server/src"],
      "@magnitudedev/icn-server/*": ["./packages/icn-server/src/*"],
      "@magnitudedev/icn-hardware": ["./packages/icn-hardware/src"],
      "@magnitudedev/icn-hardware/*": ["./packages/icn-hardware/src/*"],
      "@magnitudedev/icn": ["./packages/icn/src"],
      "@magnitudedev/icn/*": ["./packages/icn/src/*"],
    },
    "plugins": [
      { "name": "@effect/language-service" }
    ]
    },
    "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json"
}
